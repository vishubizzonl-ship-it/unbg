---
// Sticky nav — 64px, hairline bottom, canvas background (DESIGN.md: nav-bar)
const links = [
  { href: '#how', label: 'How it works' },
  { href: '#presets', label: 'Presets' },
  { href: '#use-cases', label: 'Use cases' },
  { href: '#api', label: 'API' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="sticky top-0 z-50 border-b border-hairline bg-canvas/85 backdrop-blur-md">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-[1200px] items-center gap-lg px-lg">
    <a href="/" class="flex items-center gap-xs" aria-label="unbg — home">
      <span aria-hidden="true" class="size-2 rounded-xs bg-ink"></span>
      <span class="font-mono text-body-sm font-medium tracking-tight text-ink">unbg</span>
    </a>

    <ul class="ml-lg hidden items-center gap-xxs md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-sm py-xs text-body-sm text-body transition-colors hover:bg-canvas-soft-2 hover:text-ink"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="ml-auto flex items-center gap-xs">
      <a
        href="#api"
        class="hidden h-7 items-center rounded-sm border border-hairline px-xs text-body-sm font-medium text-ink transition-colors hover:bg-canvas-soft sm:inline-flex"
      >
        Docs
      </a>
      <a
        href="#start"
        class="inline-flex h-7 items-center rounded-sm bg-ink px-xs text-body-sm font-medium text-white transition-colors hover:bg-[#383838]"
      >
        Start free
      </a>
    </div>
  </nav>
</header>
