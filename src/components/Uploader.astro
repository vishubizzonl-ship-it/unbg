---
// The one client island on the site. Everything runs locally in the browser.
import { MODELS, DEFAULT_MODEL_ID } from '../lib/models';
import { PROVIDERS } from '../lib/cloud';
---

<div id="unbg-up" class="rounded-lg bg-canvas p-sm shadow-[var(--shadow-stack-3)]">
  <!-- drop zone: the file input is the real control, the label is its face.
       (role="button" on a wrapper would nest interactives and break a11y.) -->
  <div
    id="up-drop"
    class="rounded-md border border-dashed border-hairline-strong bg-canvas-soft transition-colors hover:bg-canvas-soft-2"
  >
    <input id="up-file" type="file" accept="image/*" class="peer sr-only" />
    <label
      for="up-file"
      class="flex cursor-pointer flex-col items-center justify-center rounded-md px-lg py-xl text-center peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-link"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-6 text-mute-ink"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 16V4"></path>
        <path d="m7 9 5-5 5 5"></path>
        <path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
      </svg>
      <span class="mt-sm text-body-md font-medium text-ink">Drop an image here</span>
      <span class="mt-xxs font-mono text-caption-mono text-mute-ink">
        or click · paste with ⌘V · JPG PNG WebP · up to 25 MB
      </span>
    </label>
  </div>

  <!-- model picker -->
  <div class="mt-sm rounded-md border border-hairline p-sm">
    <div class="flex items-center justify-between gap-sm">
      <label for="up-model" class="font-mono text-caption-mono tracking-wider text-mute-ink uppercase">
        Model
      </label>
      <span id="up-device" class="font-mono text-caption-mono text-mute-ink">detecting…</span>
    </div>
    <select
      id="up-model"
      class="mt-xs w-full rounded-sm border border-hairline bg-canvas px-xs py-xxs font-mono text-body-sm text-ink"
    >
      {
        MODELS.map((m) => (
          <option value={m.id} selected={m.id === DEFAULT_MODEL_ID}>
            {m.label} · ~{m.sizeMb} MB {m.licenseOk ? '' : '· ⚠ non-commercial'}
          </option>
        ))
      }
      <optgroup label="Cloud — photo unke server par jaati hai">
        <option value="cloud:huggingface">{PROVIDERS.huggingface.label}</option>
        <option value="cloud:removebg">{PROVIDERS.removebg.label}</option>
      </optgroup>
    </select>
    <p id="up-note" class="mt-xxs text-caption-mono text-body"></p>

    <div id="up-cloud" hidden class="mt-xs rounded-sm border border-hairline bg-canvas-soft p-xs">
      <label for="up-key" id="up-key-label" class="block font-mono text-caption-mono text-body">
        remove.bg API key — free 50 images/month at remove.bg/api
      </label>
      <input
        id="up-key"
        type="password"
        autocomplete="off"
        spellcheck="false"
        placeholder="paste key here"
        class="mt-xxs w-full rounded-sm border border-hairline bg-canvas px-xs py-xxs font-mono text-body-sm text-ink"
      />
      <p id="up-key-hint" class="mt-xxs text-caption-mono text-mute-ink">
        Key sirf is phone ke browser mein rehti hai. Baaki 8 models on-device hi rehte hain.
      </p>
    </div>

    <div id="up-server" hidden class="mt-xs rounded-sm border border-hairline bg-canvas-soft p-xs">
      <label for="up-server-url" class="block font-mono text-caption-mono text-body">
        Local server URL — apna FastAPI + BiRefNet (server/README.md)
      </label>
      <input
        id="up-server-url"
        type="url"
        inputmode="url"
        spellcheck="false"
        placeholder="http://127.0.0.1:8000"
        class="mt-xxs w-full rounded-sm border border-hairline bg-canvas px-xs py-xxs font-mono text-body-sm text-ink"
      />
      <p id="up-server-hint" class="mt-xxs text-caption-mono text-mute-ink">
        Server aapka apna hai — koi key nahi, photo internet par nahi jaati.
      </p>
    </div>

    <label class="mt-xs flex items-center gap-xs text-caption-mono text-body">
      <input
        id="up-clean"
        type="checkbox"
        checked
        class="size-3.5 accent-[#171717]"
      />
      <span>Clean up — remove stray spots, fill holes, soften edges</span>
    </label>

    <label class="mt-xs flex items-center gap-xs text-caption-mono text-body">
      <input id="up-matte" type="checkbox" checked class="size-3.5 accent-[#171717]" />
      <span>Alpha matting (ViTMatte) — baal, fur, sheesha; extra ~99 MB pehli baar</span>
    </label>

    <label class="mt-xs flex items-center gap-xs text-caption-mono text-body">
      <input id="up-mask-toggle" type="checkbox" disabled class="size-3.5 accent-[#171717]" />
      <span>Mask dekho — jo AI ne kata (white = rakha, black = hataya)</span>
    </label>
  </div>

  <!-- status (announced to screen readers) -->
  <p
    id="up-status"
    role="status"
    aria-live="polite"
    class="mt-sm min-h-4 font-mono text-caption-mono text-body"
  >
  </p>

  <!-- result -->
  <div id="up-result" class="mt-sm" hidden>
    <!-- before / after slider -->
    <div id="up-compare" class="mt-sm" hidden>
      <div class="relative overflow-hidden rounded-md border border-hairline bg-canvas-soft-2">
        <img id="up-compare-before" alt="Original image" class="block w-full" />
        <img
          id="up-compare-after"
          alt="Cutout, background removed"
          class="checker absolute inset-0 size-full object-contain"
          style="clip-path: inset(0 50% 0 0)"
        />
        <div
          id="up-compare-line"
          class="pointer-events-none absolute inset-y-0 w-px bg-white shadow-[0_0_0_1px_rgba(0,0,0,0.35)]"
          style="left: 50%"
        ></div>
        <input
          id="up-compare-range"
          type="range"
          min="0"
          max="100"
          value="50"
          step="0.5"
          aria-label="Before and after slider"
          class="absolute inset-x-0 bottom-0 h-full w-full cursor-ew-resize opacity-0"
        />
      </div>
      <p class="mt-xxs font-mono text-caption-mono text-mute-ink">
        Slider kheencho — left: cutout, right: original
      </p>
    </div>

    <!-- background presets: composite happens on canvas, no second inference -->
    <div id="up-bg-row" class="mt-sm flex flex-wrap items-center gap-xs" hidden>
      <span class="font-mono text-caption-mono uppercase tracking-wider text-mute-ink">Background</span>
      <button type="button" data-bg="transparent" class="up-bg rounded-pill border border-hairline px-xs py-xxs font-mono text-caption-mono text-ink hover:bg-canvas-soft-2">
        Transparent
      </button>
      <button type="button" data-bg="white" class="up-bg rounded-pill border border-hairline px-xs py-xxs font-mono text-caption-mono text-ink hover:bg-canvas-soft-2">
        White
      </button>
      <button type="button" data-bg="black" class="up-bg rounded-pill border border-hairline px-xs py-xxs font-mono text-caption-mono text-ink hover:bg-canvas-soft-2">
        Black
      </button>
      <label class="flex items-center gap-xxs rounded-pill border border-hairline px-xs py-xxs font-mono text-caption-mono text-ink">
        <input id="up-bg-color" type="color" value="#ff8800" class="size-3.5 border-0 bg-transparent p-0" />
        <button type="button" id="up-bg-custom">Custom</button>
      </label>
    </div>

    <div class="grid grid-cols-2 gap-sm">
      <figure class="overflow-hidden rounded-md border border-hairline">
        <div class="relative aspect-[4/3] bg-canvas-soft-2">
          <img id="up-before" alt="Original image" class="absolute inset-0 size-full object-contain" />
        </div>
        <figcaption class="border-t border-hairline px-xs py-xxs font-mono text-caption-mono text-mute-ink">
          original
        </figcaption>
      </figure>

      <figure class="overflow-hidden rounded-md border border-hairline">
        <div class="checker relative aspect-[4/3]">
          <img
            id="up-after"
            alt="Result with the background removed, shown on a transparency grid"
            class="absolute inset-0 size-full object-contain"
          />
        </div>
        <figcaption
          class="border-t border-hairline px-xs py-xxs font-mono text-caption-mono text-ink"
        >
          transparent · full res
        </figcaption>
      </figure>
    </div>

    <div class="mt-sm flex flex-wrap items-center gap-xs">
      <a
        id="up-download"
        download="unbg-cutout.png"
        class="inline-flex h-10 items-center rounded-pill bg-ink px-md text-button-md text-white transition-colors hover:bg-[#383838]"
      >
        Download PNG
      </a>
      <button
        id="up-again"
        type="button"
        class="inline-flex h-10 items-center rounded-pill border border-hairline px-md text-button-md text-ink transition-colors hover:bg-canvas-soft-2"
      >
        Try another model
      </button>
      <span id="up-timing" class="font-mono text-caption-mono text-mute-ink"></span>
    </div>
  </div>

  <!-- local benchmark log — compare models on your own device -->
  <div id="up-bench-wrap" class="mt-sm" hidden>
    <table class="w-full border-collapse text-left">
      <caption class="sr-only">
        Timings for each model you have run on this device
      </caption>
      <thead>
        <tr class="border-b border-hairline">
          <th scope="col" class="py-xxs pr-xs font-mono text-caption-mono uppercase text-mute-ink">
            Model
          </th>
          <th scope="col" class="py-xxs pr-xs font-mono text-caption-mono uppercase text-mute-ink">
            Device
          </th>
          <th scope="col" class="py-xxs pr-xs font-mono text-caption-mono uppercase text-mute-ink">
            Load
          </th>
          <th scope="col" class="py-xxs font-mono text-caption-mono uppercase text-mute-ink">
            Infer
          </th>
        </tr>
      </thead>
      <tbody id="up-bench"></tbody>
    </table>
  </div>

  <p class="mt-sm flex flex-wrap items-center gap-x-sm font-mono text-caption-mono text-mute-ink">
    <span>Runs on your device — the image is never uploaded.</span>
    <span id="up-build" class="text-mute-ink">unbg v0.3 · {MODELS.length} models</span>
  </p>
</div>

<script>
  import { MODELS, DEFAULT_MODEL_ID, recommendedModelId, type BgModel } from '../lib/models';
  import { decodeImage, removeBackground, detectDevice, friendlyError } from '../lib/remove-bg';
  import { removeBackgroundImgly, imglyModelFor, IMGLY_MODEL_PREFIX } from '../lib/imgly';
  import { refineCutout } from '../lib/refine';
  import { removeBackgroundPuter, puterError, PUTER_MODEL_ID } from '../lib/puter';
  import { compositeBlob, backgroundCss, parseBackground } from '../lib/compose';
  import {
    isServerModel,
    removeBackgroundServer,
    serverHealth,
    serverBase,
    saveServerUrl,
    ServerError,
  } from '../lib/server-api';
  import {
    isCloudModel,
    cloudProvider,
    removeBackgroundCloud,
    cloudKey,
    saveCloudKey,
    CloudError,
    PROVIDERS,
  } from '../lib/cloud';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  const root = $('unbg-up');
  if (root && !root.dataset.ready) {
    root.dataset.ready = '1';

    const drop = $('up-drop')!;
    const fileInput = $<HTMLInputElement>('up-file')!;
    const select = $<HTMLSelectElement>('up-model')!;
    const cleanToggle = $<HTMLInputElement>('up-clean')!;
    const note = $('up-note')!;
    const status = $('up-status')!;
    const result = $('up-result')!;
    const before = $<HTMLImageElement>('up-before')!;
    const after = $<HTMLImageElement>('up-after')!;
    const download = $<HTMLAnchorElement>('up-download')!;
    const again = $<HTMLButtonElement>('up-again')!;
    const timing = $('up-timing')!;
    const deviceLabel = $('up-device')!;
    const cloudBlock = $('up-cloud')!;
    const serverBlock = $('up-server')!;
    const serverUrlInput = $<HTMLInputElement>('up-server-url')!;
    const serverHint = $('up-server-hint')!;
    const compare = $('up-compare')!;
    const compareBefore = $<HTMLImageElement>('up-compare-before')!;
    const compareAfter = $<HTMLImageElement>('up-compare-after')!;
    const compareRange = $<HTMLInputElement>('up-compare-range')!;
    const compareLine = $('up-compare-line')!;
    const bgRow = $('up-bg-row')!;
    const bgColor = $<HTMLInputElement>('up-bg-color')!;
    const maskToggle = $<HTMLInputElement>('up-mask-toggle')!;
    const matteToggle = $<HTMLInputElement>('up-matte')!;
    const keyInput = $<HTMLInputElement>('up-key')!;
    const keyLabel = $('up-key-label')!;
    const keyHint = $('up-key-hint')!;
    const benchWrap = $('up-bench-wrap')!;
    const benchBody = $('up-bench')!;

    let currentFile: File | Blob | null = null;
    let beforeUrl: string | null = null;
    let afterUrl: string | null = null;
    let maskUrl: string | null = null;
    let cutout: Blob | null = null;
    let cutoutName = 'unbg-cutout.png';
    let background = 'transparent';
    let busy = false;

    const cloud = (): boolean => isCloudModel(select.value);

    const model = (): BgModel =>
      MODELS.find((m) => m.id === select.value) ?? MODELS[0];

    const provider = () => cloudProvider(select.value);

    const server = (): boolean => isServerModel(select.value);

    /**
     * The cutout is kept with its real alpha; every background preset is a
     * canvas composite of that one blob, so white / custom colour is instant and
     * never re-runs a model.
     */
    async function applyBackground(value: string) {
      if (!cutout) return;
      background = value;
      for (const button of document.querySelectorAll<HTMLButtonElement>('.up-bg')) {
        const active = button.dataset.bg === value;
        button.className = active
          ? 'up-bg rounded-pill border border-ink bg-ink px-xs py-xxs font-mono text-caption-mono text-white'
          : 'up-bg rounded-pill border border-hairline px-xs py-xxs font-mono text-caption-mono text-ink hover:bg-canvas-soft-2';
      }
      const isFlat = parseBackground(value) !== null;
      after.parentElement?.classList.toggle('checker', !isFlat);
      if (isFlat) after.parentElement?.style.setProperty('background', backgroundCss(value));

      let blob: Blob;
      try {
        blob = await compositeBlob(cutout, value);
      } catch {
        setStatus('Background lagane mein dikkat aayi — transparent PNG download ho jayega.', 'error');
        return;
      }
      if (afterUrl) URL.revokeObjectURL(afterUrl);
      afterUrl = URL.createObjectURL(blob);
      after.src = afterUrl;
      compareAfter.src = afterUrl;
      download.href = afterUrl;
      const suffix = isFlat ? `-${value.replace('#', '')}` : '';
      download.setAttribute('download', cutoutName.replace(/\.png$/i, `${suffix}.png`));
    }

    async function rememberCutout(blob: Blob, name: string) {
      cutout = blob;
      cutoutName = name;
      compare.hidden = false;
      bgRow.hidden = false;
      if (beforeUrl) compareBefore.src = beforeUrl;
      compareRange.value = '50';
      compareAfter.style.clipPath = 'inset(0 50% 0 0)';
      compareLine.style.left = '50%';
      await applyBackground('transparent');
    }

    compareRange.addEventListener('input', () => {
      const percent = Number(compareRange.value);
      compareAfter.style.clipPath = `inset(0 ${100 - percent}% 0 0)`;
      compareLine.style.left = `${percent}%`;
    });

    for (const button of document.querySelectorAll<HTMLButtonElement>('.up-bg')) {
      button.addEventListener('click', () => void applyBackground(button.dataset.bg ?? 'transparent'));
    }
    $('up-bg-custom')!.addEventListener('click', () => void applyBackground(bgColor.value));
    bgColor.addEventListener('change', () => void applyBackground(bgColor.value));

    async function syncServerBlock() {
      serverBlock.hidden = !server();
      if (!server()) return;
      if (!serverUrlInput.value) serverUrlInput.value = serverBase();
      serverHint.textContent = 'Server check kar raha hoon…';
      serverHint.className = 'mt-xxs text-caption-mono text-mute-ink';
      const health = await serverHealth(serverUrlInput.value || serverBase());
      serverHint.textContent = health.ok
        ? `✓ ${health.message}`
        : `${health.message}`;
      serverHint.className = health.ok
        ? 'mt-xxs text-caption-mono text-body'
        : 'mt-xxs text-caption-mono text-error';
    }

    serverUrlInput.addEventListener('change', () => {
      saveServerUrl(serverUrlInput.value);
      void syncServerBlock();
    });

    const syncCloudBlock = (): void => {
      const info = PROVIDERS[provider()];
      cloudBlock.hidden = !cloud();
      keyLabel.textContent = info.keyLabel;
      keyInput.placeholder = info.keyPlaceholder;
      keyHint.textContent = `${info.hint} Key sirf is phone ke browser mein rehti hai; baaki 8 models on-device hi rehte hain.`;
      if (cloud()) keyInput.value = cloudKey(provider());
      deviceLabel.textContent = cloud()
        ? 'cloud'
        : server()
          ? 'local server'
          : device === 'webgpu'
            ? 'webgpu'
            : 'cpu (no webgpu)';
    };

    keyInput.addEventListener('change', () => {
      saveCloudKey(provider(), keyInput.value);
      syncCloudBlock();
    });

    let device: 'webgpu' | 'wasm' = 'wasm';
    let userPickedModel = false;
    select.addEventListener('change', () => {
      userPickedModel = true;
    });
    deviceLabel.textContent = 'detecting…';
    void detectDevice().then((detected) => {
      device = detected;
      deviceLabel.textContent = cloud()
        ? 'cloud'
        : detected === 'webgpu'
          ? 'webgpu'
          : 'cpu (no webgpu)';
      // Start on the strongest model this device can actually run.
      if (!userPickedModel) select.value = recommendedModelId(detected);
      updateNote();
    });

    function updateNote() {
      if (cloud()) {
        note.textContent = `${PROVIDERS[provider()].label.replace('Cloud · ', '')} — photo unke server par jaati hai.`;
        note.className = 'mt-xxs text-caption-mono text-body';
        syncCloudBlock();
        return;
      }
      const m = model();
      if (m.engine === 'server') {
        note.textContent = `${m.note} · license: ${m.license}`;
        note.className = 'mt-xxs text-caption-mono text-body';
        syncCloudBlock();
        void syncServerBlock();
        return;
      }
      if (m.engine === 'puter') {
        note.textContent = `${m.note} · license: ${m.license}`;
        note.className = 'mt-xxs text-caption-mono text-body';
        syncCloudBlock();
        return;
      }
      if (m.engine === 'imgly') {
        note.textContent = `${m.note} · ~${m.sizeMb} MB · license: ${m.license}`;
        note.className = 'mt-xxs text-caption-mono text-body';
        syncCloudBlock();
        return;
      }
      const bits = [m.note, `license: ${m.license}`];
      if (m.webgpuOnly && device !== 'webgpu') bits.push('needs WebGPU — use another model');
      if (!m.webgpuOnly && device !== 'webgpu' && m.sizeMb >= 50)
        bits.push('CPU par bada model — slow ya out-of-memory ho sakta hai; MODNet try karein');
      if (!m.licenseOk) bits.push('⚠ testing only, not for commercial use');
      note.textContent = bits.join(' · ');
      note.className = m.licenseOk
        ? 'mt-xxs text-caption-mono text-body'
        : 'mt-xxs text-caption-mono text-error';
    }
    select.addEventListener('change', () => {
      updateNote();
      syncCloudBlock();
      void syncServerBlock();
    });
    updateNote();

    function setStatus(message: string, tone: 'normal' | 'error' = 'normal') {
      status.textContent = message;
      status.className =
        tone === 'error'
          ? 'mt-sm min-h-4 font-mono text-caption-mono text-error'
          : 'mt-sm min-h-4 font-mono text-caption-mono text-body';
    }

    const measure = async (blob: Blob): Promise<string> => {
      try {
        const bitmap = await createImageBitmap(blob);
        const text = `${bitmap.width}×${bitmap.height}`;
        bitmap.close?.();
        return text;
      } catch {
        return 'PNG';
      }
    };

    const fmt = (ms: number) => (ms >= 1000 ? `${(ms / 1000).toFixed(1)}s` : `${Math.round(ms)}ms`);

    function addBench(modelName: string, dev: string, loadMs: number, inferMs: number) {
      benchWrap.hidden = false;
      const row = document.createElement('tr');
      row.className = 'border-b border-hairline';
      for (const value of [modelName, dev, fmt(loadMs), fmt(inferMs)]) {
        const cell = document.createElement('td');
        cell.className = 'py-xxs pr-xs font-mono text-caption-mono text-body';
        cell.textContent = value;
        row.append(cell);
      }
      benchBody.prepend(row);
    }

    async function run(file: File | Blob) {
      if (busy) return;
      busy = true;
      currentFile = file;

      result.hidden = false;
      after.removeAttribute('src');
      compare.hidden = true;
      bgRow.hidden = true;
      cutout = null;
      setStatus('Reading image…');
      again.disabled = true;
      drop.setAttribute('aria-busy', 'true');

      try {
        // Decode before a single byte of model is fetched: a HEIC photo should
        // not cost a 209 MB download before the user is told it cannot open.
        const decoded = await decodeImage(file);
        if (beforeUrl) URL.revokeObjectURL(beforeUrl);
        beforeUrl = URL.createObjectURL(decoded.preview);
        before.src = beforeUrl;
        before.alt = `Original image · ${decoded.width}×${decoded.height}`;

        if (cloud()) {
          const chosen = provider();
          const out = await removeBackgroundCloud(file, chosen, ({ message }) => setStatus(message));
          if (afterUrl) URL.revokeObjectURL(afterUrl);
          afterUrl = URL.createObjectURL(out.blob);
          after.src = afterUrl;
          download.href = afterUrl;
          const isHf = chosen === 'huggingface';
          const cloudName = isHf ? 'Hugging Face' : 'remove.bg';
          download.setAttribute('download', isHf ? 'unbg-huggingface.png' : 'unbg-removebg.png');
          await rememberCutout(out.blob, isHf ? 'unbg-huggingface.png' : 'unbg-removebg.png');
          timing.textContent = `${cloudName} · cloud · ${out.width}×${out.height}`;
          addBench(`${cloudName} (cloud)`, 'cloud', 0, 0);
          setStatus(`Done — background removed on ${cloudName}, full resolution PNG ready.`);
          return;
        }

        if (select.value === PUTER_MODEL_ID) {
          const out = await removeBackgroundPuter(file, ({ message }) => setStatus(message));
          if (afterUrl) URL.revokeObjectURL(afterUrl);
          afterUrl = URL.createObjectURL(out.blob);
          after.src = afterUrl;
          download.href = afterUrl;
          download.setAttribute('download', 'unbg-puter.png');
          await rememberCutout(out.blob, 'unbg-puter.png');
          timing.textContent = `Puter · ${out.width}×${out.height} · ${out.transparentPct}% transparent`;
          addBench('Puter (cloud, user pays)', 'cloud', 0, 0);
          setStatus(
            out.transparentPct > 5
              ? `Done — Puter ne background hata diya (${out.transparentPct}% pixels transparent).`
              : 'Puter ne image di par background poora transparent nahi hua — accurate cutout ke liye on-device ya remove.bg model chuno.',
          );
          return;
        }

        if (select.value.startsWith(IMGLY_MODEL_PREFIX)) {
          const out = await removeBackgroundImgly(file, imglyModelFor(select.value), (percent, label) =>
            setStatus(`${label}… ${percent}%`),
          );
          // The library returns a finished PNG, so the halo around hair is
          // still in it: run our own morphology on the alpha channel.
          let blob = out.blob;
          let note = '';
          if (cleanToggle.checked) {
            setStatus('Edges saaf kar raha hoon — halo aur stray spots…');
            const refined = await refineCutout(out.blob, { clean: true, erodePx: 1 });
            blob = refined.blob;
            note = ` · mask ${Math.round(refined.coverage * 100)}%`;
          }
          if (afterUrl) URL.revokeObjectURL(afterUrl);
          afterUrl = URL.createObjectURL(blob);
          after.src = afterUrl;
          download.href = afterUrl;
          download.setAttribute('download', 'unbg-imgly.png');
          await rememberCutout(blob, 'unbg-imgly.png');
          const size = await measure(blob);
          timing.textContent = `IMG.LY ${imglyModelFor(select.value)} · web worker · ${(out.ms / 1000).toFixed(1)}s · ${size}${note}`;
          addBench(`IMG.LY ${imglyModelFor(select.value)} (worker)`, 'worker', out.ms, out.ms);
          setStatus(`Done — IMG.LY ${(out.ms / 1000).toFixed(1)}s, edges refined.`);
          return;
        }

        if (isServerModel(select.value)) {
          const out = await removeBackgroundServer(
            file,
            select.value,
            {
              matte: matteToggle.checked,
              detail: 'normal',
              subject: model().scope === 'portrait' ? 'person' : 'object',
            },
            ({ message }) => setStatus(message),
          );
          await rememberCutout(out.blob, 'unbg-server.png');
          const label = out.meta.model_label ?? out.meta.model;
          const coverage =
            typeof out.meta.coverage === 'number'
              ? ` · mask ${Math.round(out.meta.coverage * 100)}%`
              : '';
          timing.textContent = `${label} · local server · ${(out.ms / 1000).toFixed(1)}s · ${out.meta.width}×${out.meta.height}${coverage}`;
          addBench(label, 'server', 0, out.ms);
          setStatus(`Done — server ne background hata diya, full resolution PNG ready.`);
          return;
        }

        const out = await removeBackground(decoded, select.value, ({ message }) => setStatus(message), {
          device,
          clean: cleanToggle.checked,
          matte: matteToggle.checked,
        });
        if (afterUrl) URL.revokeObjectURL(afterUrl);
        afterUrl = URL.createObjectURL(out.blob);
        after.src = afterUrl;
        download.href = afterUrl;
        download.setAttribute('download', `unbg-${model().label.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}.png`);
        await rememberCutout(out.blob, `unbg-${model().label.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}.png`);
        const total = out.loadMs + out.inferMs;
        const cleaned = out.cleanup.blobsRemoved + out.cleanup.holesFilled;
        const cleanNote = cleaned > 0 ? ` · cleaned ${cleaned}px` : '';
        if (maskUrl) URL.revokeObjectURL(maskUrl);
        maskUrl = out.maskBlob ? URL.createObjectURL(out.maskBlob) : null;
        maskToggle.disabled = !maskUrl;
        maskToggle.checked = false;

        const coverageNote = ` · mask ${Math.round(out.coverage * 100)}%`;
        const matteNote = out.matteMs > 0 ? ` · matte ${fmt(out.matteMs)}` : '';
        const scaleNote = out.scaled
          ? ' · scaled to 40 MP'
          : decoded.downscaled
            ? ' · phone ne 2048px par decode kiya'
            : '';
        timing.textContent = `${out.modelLabel} · ${out.device} · ${fmt(out.inferMs)} (total ${fmt(total)}) · ${out.width}×${out.height}${cleanNote}${scaleNote}${coverageNote}${matteNote}`;
        addBench(out.modelLabel, out.device, out.loadMs, out.inferMs);
        setStatus(`Done — ${fmt(out.inferMs)} inference, full resolution PNG ready.`);
      } catch (error) {
        const message =
          error instanceof ServerError
            ? error.message
            : error instanceof CloudError
              ? error.message
              : select.value === PUTER_MODEL_ID
                ? puterError(error)
                : friendlyError(error, model().label);
        setStatus(`Failed: ${message}`, 'error');
      } finally {
        busy = false;
        again.disabled = false;
        drop.removeAttribute('aria-busy');
      }
    }

    function accept(files: FileList | null) {
      const file = files?.[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        setStatus('That is not an image file.', 'error');
        return;
      }
      if (file.size > 25 * 1024 * 1024) {
        setStatus('Image is larger than 25 MB.', 'error');
        return;
      }
      void run(file);
    }

    fileInput.addEventListener('change', () => accept(fileInput.files));

    for (const type of ['dragenter', 'dragover'] as const) {
      drop.addEventListener(type, (event) => {
        event.preventDefault();
        drop.classList.add('bg-canvas-soft-2');
      });
    }
    for (const type of ['dragleave', 'drop'] as const) {
      drop.addEventListener(type, (event) => {
        event.preventDefault();
        drop.classList.remove('bg-canvas-soft-2');
      });
    }
    drop.addEventListener('drop', (event) => {
      const dt = (event as DragEvent).dataTransfer;
      accept(dt?.files ?? null);
    });

    // paste anywhere on the page
    window.addEventListener('paste', (event) => {
      const item = Array.from(event.clipboardData?.items ?? []).find((i) =>
        i.type.startsWith('image/'),
      );
      const file = item?.getAsFile();
      if (file) {
        event.preventDefault();
        void run(file);
      }
    });

    maskToggle.addEventListener('change', () => {
      if (maskToggle.checked && maskUrl) {
        after.src = maskUrl;
      } else if (afterUrl) {
        after.src = afterUrl;
      }
    });

    again.addEventListener('click', () => {
      if (currentFile) void run(currentFile);
    });
  }
</script>
