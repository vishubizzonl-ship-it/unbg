---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-hairline border-y border-hairline">
  {
    items.map((item) => (
      <details class="group py-lg">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-md">
          <h3 class="text-body-md font-medium text-ink">{item.q}</h3>
          <span
            aria-hidden="true"
            class="mt-0.5 shrink-0 font-mono text-body-sm text-mute-ink transition-transform group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <p class="mt-sm max-w-[70ch] text-body-sm text-body">{item.a}</p>
      </details>
    ))
  }
</div>
