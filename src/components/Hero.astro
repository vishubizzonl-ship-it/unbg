---
import Uploader from './Uploader.astro';

// Hero: mesh gradient at hero scale only (DESIGN.md), display-xl headline,
// 100px pill marketing CTAs, mono micro-copy.
---

<section class="relative overflow-hidden" aria-labelledby="hero-title">
  <!-- brand mesh gradient — decorative, hero scale only -->
  <div
    aria-hidden="true"
    class="mesh pointer-events-none absolute inset-x-0 -top-40 h-[520px] opacity-30 blur-3xl"
  >
  </div>

  <div class="relative mx-auto grid max-w-[1200px] items-start gap-2xl px-lg pt-5xl pb-3xl lg:grid-cols-[1.05fr_0.95fr] lg:gap-4xl lg:pt-6xl lg:pb-4xl">
    <div>
      <p class="font-mono text-caption-mono tracking-wider text-mute-ink uppercase">
        Background removal · no login · full resolution
      </p>

      <h1 id="hero-title" class="mt-md text-display-lg text-ink lg:text-display-xl">
        Remove the background.{' '}
        <br class="hidden sm:block" />
        Keep every pixel.
      </h1>

      <p class="mt-lg max-w-[46ch] text-body-lg text-body">
        Transparent PNG in seconds — no signup, no watermark, no credit maths. Run it on your own
        device for total privacy, or in the cloud when you need the best edges.
      </p>

      <div class="mt-xl flex flex-wrap items-center gap-sm">
        <a
          href="#start"
          class="inline-flex h-12 items-center rounded-pill bg-ink px-lg text-button-lg text-white transition-colors hover:bg-[#383838]"
        >
          Start free
        </a>
        <a
          href="#api"
          class="inline-flex h-12 items-center rounded-pill border border-hairline bg-canvas px-lg text-button-lg text-ink transition-colors hover:bg-canvas-soft-2"
        >
          See the API
        </a>
      </div>

      <p class="mt-lg font-mono text-caption-mono text-mute-ink">
        PNG · JPG · WebP · AVIF — up to 25 MB. No account needed to download.
      </p>
    </div>

    <div id="start" class="w-full">
      <Uploader />
    </div>
  </div>
</section>
