---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'unbg — remove image backgrounds, full resolution, no signup',
  description = 'Remove image backgrounds in seconds. Full-resolution transparent PNG, no watermark, no account. On-device mode keeps your images on your machine.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-dvh bg-canvas text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-sm focus:left-sm focus:z-[100] focus:rounded-sm focus:bg-ink focus:px-sm focus:py-xs focus:text-body-sm focus:text-white"
    >
      Skip to content
    </a>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
